# Server-side only. Base URL of apps/api, used by the Next.js server, never the browser.
API_BASE_URL=http://127.0.0.1:8000

# Web authentication (server-side only; put real values in .env.local, never in git).
# Public origin of this app; must be https (local: `make web-dev-https`).
APP_ORIGIN=https://localhost:3000
# OIDC issuer exactly as in tokens, e.g. https://<tenant>.eu.auth0.com/
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# API identifier (Auth0 audience) that the API's AUTH_AUDIENCE expects.
OIDC_AUDIENCE=
# At least 32 random characters, e.g. `openssl rand -base64 48`.
SESSION_SECRET=
# Optional, during key rotation only: the previous SESSION_SECRET (still unseals, never seals).
SESSION_SECRET_PREVIOUS=
